---
import '../styles/global.css';
import { version } from '../lib/rpm.mjs';

const {
  title = 'Sandminni — Persistent Project Memory',
  description = 'Durable project memory, grain by grain. Sandminni is the public brand for PPM, the reference implementation of PPMP.'
} = Astro.props;
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1020" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Sandminni home">
          <span class="brand-mark">S</span>
          <span><strong>Sandminni</strong><small>Persistent Project Memory · PPM</small></span>
        </a>
        <nav aria-label="Primary navigation">
          <a class:list={[{ active: pathname === '/quick-start' }]} href="/quick-start">Quick Start</a>
          <a class:list={[{ active: pathname === '/reference' || pathname.startsWith('/spec/') || pathname.startsWith('/profiles/') || pathname.startsWith('/implementations/') || pathname.startsWith('/backends/') || pathname.startsWith('/adapters/') || pathname.startsWith('/templates/') }]} href="/reference">Reference</a>
          <span class="version-pill">PPMP v{version}</span>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>Sandminni · Persistent Project Memory (PPM) · reference implementation of PPMP v{version}.</p>
        <p class="muted">Sandminni is the product brand; PPMP is the protocol. The website is non-normative; repository specification files remain authoritative.</p>
      </div>
    </footer>
  </body>
</html>
