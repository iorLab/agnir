---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGroups } from '../lib/rpm.mjs';
const groups = getGroups();
---
<BaseLayout title="Reference · PPMP">
  <section class="page-hero shell"><p class="eyebrow">Reference</p><h1>The PPMP source, presented for humans.</h1><p class="lede">Protocol pages are normative only because their repository files are normative. PPM implementation, backend, adapter, profile, and template pages are clearly separated by layer.</p></section>
  <section class="section shell reference-index">{groups.map((group) => (<div class="reference-group"><div><p class="eyebrow">{group.label}</p><h2>{group.label}</h2><p>{group.description}</p></div><div class="doc-list">{group.documents.map((doc) => (<a href={`/${doc.kind}/${doc.slug}`}><div><strong>{doc.title}</strong><small>{doc.path}</small></div><span>→</span></a>))}</div></div>))}</section>
</BaseLayout>
