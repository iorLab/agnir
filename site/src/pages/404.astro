---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not found · PPMP">
  <section class="page-hero shell narrow not-found">
    <p class="eyebrow">404</p>
    <h1>This PPMP page does not exist.</h1>
    <p class="lede">Return to the reference index or start with the quick setup flow.</p>
    <div class="hero-actions">
      <a class="button primary" href="/reference">Reference</a>
      <a class="button secondary" href="/quick-start">Quick Start</a>
    </div>
  </section>
</BaseLayout>
